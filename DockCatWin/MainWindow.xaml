<Window x:Class="DockCatWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockCatWin"
        Width="150"
        Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Grid Background="Transparent">
        <Image x:Name="CatImage"
               Width="150"
               Height="150"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="CatImage_MouseLeftButtonDown"
               MouseRightButtonUp="CatImage_MouseRightButtonUp">
            <Image.RenderTransform>
                <ScaleTransform x:Name="MirrorTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
