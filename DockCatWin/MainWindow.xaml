<Window x:Class="DockCatWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockCatWin"
        Width="150"
        Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Grid x:Name="RootLayout" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BubbleBorder"
                Grid.Row="0"
                MaxWidth="280"
                Margin="0,0,0,8"
                Padding="10"
                Background="#F4FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="BubbleText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#202020" />
                <StackPanel x:Name="BubbleButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Image x:Name="CatImage"
               Grid.Row="1"
               Width="150"
               Height="150"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="CatImage_MouseLeftButtonDown"
               MouseRightButtonUp="CatImage_MouseRightButtonUp">
            <Image.RenderTransform>
                <ScaleTransform x:Name="MirrorTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
